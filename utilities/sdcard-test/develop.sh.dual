#!/bin/sh
# 1 枚のカードで Goggle 2 (自分の) と借り物の Goggle v1 を起動し分ける。
# SD カードに develop.sh という名前でコピーして使う。フラッシュには何も書かない。
#
#   Goggle 2 -> $SYS/develop.g2.sh をそのまま実行する (それまでの
#               develop.sh を改名したもの。中身は触らない)
#   Goggle v1 -> $SYS/HDZGOGGLE.v1 (build_goggle のビルド) を RAM (/tmp) に
#               コピーして起動する。無ければ純正。起動しなければ 8 秒後に純正。
#               v1 に入っているのが 9.5.0 でも 9.6 でもよい (アプリが FPGA の版を
#               見て合わせる)。
#
# 機種は内蔵の純正アプリで見分ける。
#   /mnt/app/platform (9.6 以降の純正にある) が HDZGOGGLE2 -> Goggle 2
#   platform が無く、純正アプリに goggle2 の文字列が大文字小文字を問わず
#   ある -> Goggle 2。9.5.1 系の Goggle 2 用は "HDZERO_GOGGLE2" (大文字) だけ、
#   9.6 以降は hardware-goggle2.c など。
#   platform が無く、その文字列も無い -> v1。v9.5.0 のソースには goggle2 が
#   大文字小文字とも一つも無い (git grep -i で確認)。
#   platform が HDZGOGGLE (9.6 以降の Goggle 1) -> v1。
#   platform がそれ以外 (Box Pro など) -> どちら用でもない。純正を起動するだけ。
# 最初の版は小文字の goggle2 しか見ておらず、9.5.1 系の Goggle 2 を v1 と
# 取り違えるところだった。見分けた結果は model-history.txt に残す。
# v1 側はバイナリの名前も分けてある (HDZGOGGLE は Goggle 2 用のまま)。
# カードの整理 (2026-10-29): 動かすのに要るものは fork-system/、消してよいもの
# (ログ、古い版) は fork-deletable/。カード直下に残すのは純正のもの
# (DCIM, FIRMWARE, FSCK, log, HDZG_*.bin などの決まった名前) と、フラッシュの
# 入口が名前で呼ぶ rc-exp.sh, init-exp.sh, early-exp.sh, develop.sh だけ。
SYS=/mnt/extsd/fork-system
DEL=/mnt/extsd/fork-deletable

# 起動の内訳 (カーネル → init → rc.sh → ここ) を取る。入った時点の経過秒を
# 渡し、採取そのものは裏で走らせてアプリの起動を遅らせない。boot-trace.sh が
# カードに無ければ何もしない。結果は boot-trace/NNN/、読むのは boot-trace-report.py。
ENTRY_UPTIME=$(cut -d' ' -f1 /proc/uptime)
[ -e $SYS/boot-trace.sh ] && /bin/sh $SYS/boot-trace.sh "$ENTRY_UPTIME" &

STOCK=/mnt/app/app/HDZGOGGLE
PLATFORM=$(cat /mnt/app/platform 2>/dev/null)
if [ "$PLATFORM" = HDZGOGGLE2 ]; then
	MODEL=g2
elif [ "$PLATFORM" = HDZGOGGLE ]; then
	MODEL=v1
elif [ -n "$PLATFORM" ]; then
	MODEL=other
elif [ "$(ls -l "$STOCK" 2>/dev/null | awk '{print $5}')" = 2738548 ]; then
	# Goggle 2 の純正 9.5.1 の大きさ (2026-10-16 の緊急更新の前後で同じ)。
	# 下の grep は純正アプリ 2.7MB を読むので起動のたびに 1.1 秒かかる。
	# 大きさが違えば grep で見分ける。
	MODEL=g2
elif grep -qi goggle2 "$STOCK"; then
	MODEL=g2
else
	MODEL=v1
fi
# 起動時間の実験 (init-exp.sh の段階 17 以降) では、起動の経路にある sync を
# 裏に回す。カードの rc-exp.sh が後で sync する。
SYNC_BG=0
if [ "$(cat /tmp/exp-stage 2>/dev/null | tr -dc 0-9)" -ge 17 ] 2>/dev/null; then
	SYNC_BG=1
fi
export SYNC_BG
if [ "$SYNC_BG" = 1 ]; then
	( echo "platform=[$PLATFORM] model=$MODEL" >> $DEL/model-history.txt && sync ) > /dev/null 2>&1 &
else
	( echo "platform=[$PLATFORM] model=$MODEL" >> $DEL/model-history.txt && sync ) 2>/dev/null
fi

if [ "$MODEL" = g2 ]; then
	# 設定とフラッシュ全体の控え (緊急更新の前に取るもの)。読むだけ。初回だけ
	# 数十秒かかり、その間は映像が出ない。2 回目からは setting.ini を写すだけ。
	# goggle2-backup.sh がカードに無ければ何もしない。
	[ -e $SYS/goggle2-backup.sh ] && /bin/sh $SYS/goggle2-backup.sh g2
	# 緊急更新で初期値に戻った setting.ini を、カードの控えで一度だけ書き戻す。
	# 無ければ何もしない。控えを取った後に呼ぶので、書き戻す前の設定も残る。
	[ -e $SYS/goggle2-restore-setting.sh ] && /bin/sh $SYS/goggle2-restore-setting.sh g2
	# PhoenixCard や緊急更新で消えた、起動時間の実験用の入口 2 つ (rc.sh と
	# rc.final) を一度だけ入れ直す。無ければ何もしない。理由と手順は
	# goggle2-install-hooks.sh。フラッシュに書く唯一の控え系スクリプト。
	[ -e $SYS/goggle2-install-hooks.sh ] && /bin/sh $SYS/goggle2-install-hooks.sh g2
	# Wi-Fi で Mac から SSH で入れるように、ゴーグルの方から Mac へ ping を出す。
	# 理由は wifi-hello.sh。宛先は wifi-hello.txt。無ければ何もしない。
	[ -e $SYS/wifi-hello.sh ] && /bin/sh $SYS/wifi-hello.sh > /dev/null 2>&1 &
	if [ -e $SYS/develop.g2.sh ]; then
		exec /bin/sh $SYS/develop.g2.sh
	fi
	"$STOCK" &
	exit 0
fi
if [ "$MODEL" != v1 ]; then
	"$STOCK" &
	exit 0
fi

# ここから Goggle v1。develop.sh.stage1 と同じ手順に、起動しなかったときの
# 純正へのフォールバックを足したもの。

# カードが書けるかを最初に確かめる。書けないカードでログへのリダイレクトが
# 失敗すると、シェルはそのコマンド (アプリの起動) を実行しない。
mkdir -p $DEL 2>/dev/null
LOG=$DEL/HDZGOGGLE.log
WRITABLE=0
if ( : > /mnt/extsd/.wtest ) 2>/dev/null; then
	rm -f /mnt/extsd/.wtest
	WRITABLE=1
fi

# 前回のログがまだ残っているなら、前回はアプリが boot-logs/ への退避に
# 到達しなかった印。この後の "> $LOG" が消すので、先に名前を変えて残す。
save_unrotated_log() {
	[ -s "$LOG" ] || return 0
	mkdir -p $DEL/boot-logs
	n=1
	while [ -e "$DEL/boot-logs/HDZGOGGLE.unrotated.$n.log" ]; do
		n=$((n + 1))
	done
	mv "$LOG" "$DEL/boot-logs/HDZGOGGLE.unrotated.$n.log"
}

start_app() {
	if [ "$WRITABLE" = "1" ]; then
		"$1" > "$LOG" 2>&1 &
	else
		"$1" &
	fi
}

# アプリは fork して親が抜けるので $! は当てにならない。名前で探す。
app_pid() {
	for d in /proc/[0-9]*; do
		if grep -qs HDZGOGGLE "$d/cmdline" 2>/dev/null; then
			echo "${d#/proc/}"
			return 0
		fi
	done
	return 1
}

# 起動しなかったときの保険。ローダが何かを解決できないと、何も表示されない
# まま止まる。そうなったら純正に戻す。
fallback_if_dead() {
	sleep 8
	if app_pid > /dev/null; then
		return 0
	fi
	[ "$WRITABLE" = "1" ] && echo "v1: fork が起動しなかったので純正で起動" >> "$B/stage-history.txt" && sync
	/mnt/app/app/HDZGOGGLE &
}

# 返却前に書き戻すための、借りた時点の setting.ini。すでにあれば (Mac の
# 控えから入れたものを含めて) 触らない。
B=$SYS/goggle-backup

if [ "$WRITABLE" = "1" ]; then
	save_unrotated_log
	mkdir -p "$B"
	if [ ! -e "$B/setting.ini.orig" ]; then
		cp /mnt/app/setting.ini "$B/setting.ini.orig"
	fi
	cp /mnt/app/setting.ini "$B/setting.ini.last-boot"
	echo "dual v1 ran" >> "$B/stage-history.txt"
	# libISP が書き直すカード直下の isp0_0_0_0_ctx_saved.bin は、電源断で途中に
	# なると FAT の連鎖が壊れ、カーネルがカードを読み取り専用にする。同名の
	# ディレクトリで書けなくする。理由は develop.sh.vopatch の guard_isp_ctx。
	ISP_CTX=/mnt/extsd/isp0_0_0_0_ctx_saved.bin
	if [ ! -d "$ISP_CTX" ]; then
		rm -f "$ISP_CTX" 2>/dev/null
		mkdir "$ISP_CTX" 2>/dev/null && echo "v1: isp ctx をディレクトリに置き換えた" >> "$B/stage-history.txt"
	fi
	sync
fi

# カードから直接実行すると、抜き差しした後にアプリがまだ読んでいない部分を
# 読みに行ったところで SIGBUS で落ちる (Goggle 2 で 2026-09-30 に実際に起きた。
# develop.sh.vopatch を参照)。RAM (/tmp は tmpfs) にコピーしてそこから実行する。
# コピーに失敗したらカードから。
if [ -e $SYS/HDZGOGGLE.v1 ]; then
	APP=$SYS/HDZGOGGLE.v1
	if cp $SYS/HDZGOGGLE.v1 /tmp/HDZGOGGLE && chmod +x /tmp/HDZGOGGLE; then
		APP=/tmp/HDZGOGGLE
	fi
else
	APP=/mnt/app/app/HDZGOGGLE
fi
[ "$WRITABLE" = "1" ] && echo "v1: app $APP" >> "$B/stage-history.txt" && sync

start_app "$APP"
if [ "$APP" != /mnt/app/app/HDZGOGGLE ]; then
	fallback_if_dead &
fi
