#!/bin/sh
# Stage 0: 何も変えない確認用。
# 純正の rc.sh が SD ルートの develop.sh を見つけて実行することだけを確かめ、
# 読み取り専用でバックアップと環境情報を SD に写した後、純正アプリを起動する。
# SD カードに develop.sh という名前でコピーして使う。
#
# 書き込み先は /mnt/extsd (SD カード) のみ。/mnt/app (フラッシュ) は読むだけ。

# カードが書けるかを最初に確かめる。
#
# 録画中に電源を切ると FAT が read-only に落ちることがある。そうなると下の
# "> $LOG" がファイルを開けず、リダイレクトが失敗したコマンドをシェルは
# 実行しない。つまりアプリが起動せず、ゴーグルは起動画面のまま止まる。
# 2026-09-16 に実際にこれが起きた。ログを取れないことと起動しないことは
# 別の話なので、書けないときはログを捨ててでも起動させる。
LOG=/mnt/extsd/HDZGOGGLE.log
WRITABLE=0
# サブシェルに包む。リダイレクトの失敗を報告するのはコマンドではなくシェル
# 自身なので、"2>/dev/null" をコマンドに付けても黙らない。
if ( : > /mnt/extsd/.wtest ) 2>/dev/null; then
	rm -f /mnt/extsd/.wtest
	WRITABLE=1
fi

# 前回のログがまだここに残っているなら、前回はアプリが boot-logs/ への退避に
# 到達しなかった印 (起動しなかったか、途中で止まった)。この後の "> $LOG" が
# 消すので、先に名前を変えて残す。アプリの番号管理は HDZGOGGLE.NNNN.log しか
# 見ないため、この名前は数にも入らず勝手に消されもしない。
save_unrotated_log() {
	[ -s "$LOG" ] || return 0
	mkdir -p /mnt/extsd/boot-logs
	n=1
	while [ -e "/mnt/extsd/boot-logs/HDZGOGGLE.unrotated.$n.log" ]; do
		n=$((n + 1))
	done
	mv "$LOG" "/mnt/extsd/boot-logs/HDZGOGGLE.unrotated.$n.log"
}

# 書けるならログを取り、書けないならログなしで起動する。
start_app() {
	if [ "$WRITABLE" = "1" ]; then
		"$1" > "$LOG" 2>&1 &
	else
		"$1" &
	fi
}

B=/mnt/extsd/goggle-backup

if [ "$WRITABLE" = "1" ]; then
	save_unrotated_log
	mkdir -p "$B"

	# 借りた時点の setting.ini。一度取ったら上書きしない (返却時の復元元)。
	if [ ! -e "$B/setting.ini.orig" ]; then
		cp /mnt/app/setting.ini "$B/setting.ini.orig"
	fi
	cp /mnt/app/setting.ini "$B/setting.ini.last-boot"

	# 互換性判断の材料。純正アプリ版・プラットフォーム・カーネル・モジュール・MTD 構成。
	cat /mnt/app/version  > "$B/version.txt"  2>&1
	cat /mnt/app/platform > "$B/platform.txt" 2>&1
	uname -a              > "$B/uname.txt"    2>&1
	cat /proc/cmdline     > "$B/cmdline.txt"  2>&1
	cat /proc/mtd         > "$B/proc_mtd.txt" 2>&1
	cat /proc/mounts      > "$B/mounts.txt"   2>&1
	lsmod                 > "$B/lsmod.txt"    2>&1
	dmesg                 > "$B/dmesg.txt"    2>&1
	ls -laR /mnt/app      > "$B/mnt_app_ls.txt" 2>&1
	md5sum /mnt/app/app/HDZGOGGLE /mnt/app/ko/*.ko /mnt/app/app/record/record \
	                      > "$B/md5.txt"      2>&1
	echo "stage0 ran" >> "$B/stage-history.txt"
	sync
fi

# 純正アプリ。
start_app /mnt/app/app/HDZGOGGLE
