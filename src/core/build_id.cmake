# Writes the build id main() stamps into the log. Run on every build (cmake -P)
# with SRC_DIR, the source tree, and OUT, the header to write. Taken at
# configure time, it stayed at whatever commit cmake last ran on, and the log
# named a binary that was not the one running (2026-10-30). The header is only
# rewritten when the id changes, so an unchanged tree rebuilds nothing.
file(STRINGS "${SRC_DIR}/VERSION" base LIMIT_COUNT 1)
execute_process(
	COMMAND git describe --always --dirty
	WORKING_DIRECTORY "${SRC_DIR}"
	OUTPUT_VARIABLE id
	OUTPUT_STRIP_TRAILING_WHITESPACE
	ERROR_QUIET
)
# git is not always in the build container.
if(NOT id)
	set(id "no-git")
endif()

file(WRITE "${OUT}.tmp" "// Generated by src/core/build_id.cmake. Do not edit.\n#define APP_BASE_VERSION \"${base}\"\n#define APP_BUILD_ID \"${id}\"\n")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
